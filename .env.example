# Reddit API — get free credentials at https://www.reddit.com/prefs/apps
# Create a "script" type app, copy the client_id (under app name) and secret
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=TrendScanner/1.0

# TikTok — log into TikTok in Chrome, open DevTools > Application > Cookies
# Copy the value of the "msToken" cookie and paste it here
TIKTOK_MS_TOKEN=your_ms_token_here

# X (Twitter) API — free tier at https://developer.x.com
# Sign up, create a project + app, copy the Bearer Token
X_BEARER_TOKEN=your_bearer_token_here
